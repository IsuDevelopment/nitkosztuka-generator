generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  login        String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.Text
  name         String   @db.VarChar(200)
  isAdmin      Boolean  @default(false) @map("is_admin")
  createdAt    DateTime @default(now()) @map("created_at")
  createdById  String?  @map("created_by_id")

  createdBy     User?       @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers  User[]      @relation("UserCreatedBy")
  brands        Brand[]
  clients       Client[]
  deliveryMethods DeliveryMethod[]
  taxRates      TaxRate[]
  orders        Order[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Brand {
  id                  String   @id @default(uuid())
  name                String   @db.VarChar(200)
  subtitle            String?  @db.VarChar(300)
  websiteUrl          String?  @map("website_url") @db.Text
  defaultPaymentText  String?  @map("default_payment_text") @db.Text
  defaultHandmadeText String?  @map("default_handmade_text") @db.Text
  defaultLeadTime     String   @default("7–10 dni roboczych") @map("default_lead_time") @db.VarChar(200)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdById         String   @map("created_by_id")

  createdBy       User             @relation(fields: [createdById], references: [id])
  deliveryMethods DeliveryMethod[]
  orders          Order[]

  @@map("brands")
}

model Client {
  id             String   @id @default(uuid())
  firstName      String   @map("first_name") @db.VarChar(100)
  lastName       String   @map("last_name") @db.VarChar(100)
  email          String?  @db.VarChar(300)
  phone          String?  @db.VarChar(50)
  defaultAddress String?  @map("default_address") @db.Text
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdById    String   @map("created_by_id")

  createdBy User    @relation(fields: [createdById], references: [id])
  orders    Order[]

  @@map("clients")
}

model DeliveryMethod {
  id          String   @id @default(uuid())
  brandId     String   @map("brand_id")
  name        String   @db.VarChar(200)
  defaultCost Decimal  @default(0) @map("default_cost") @db.Decimal(10, 2)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String   @map("created_by_id")

  brand     Brand   @relation(fields: [brandId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])
  orders    Order[]

  @@map("delivery_methods")
}

model TaxRate {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  rate        Decimal  @db.Decimal(5, 2)
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String   @map("created_by_id")

  createdBy User    @relation(fields: [createdById], references: [id])
  orders    Order[]

  @@map("tax_rates")
}

model Order {
  id                 String           @id @default(uuid())
  orderNumber        String           @unique @map("order_number") @db.VarChar(50)
  brandId            String           @map("brand_id")
  clientId           String           @map("client_id")
  acceptanceStatus   AcceptanceStatus @default(PENDING) @map("acceptance_status")
  paymentStatus      PaymentStatus    @default(PENDING) @map("payment_status")
  deliveryStatus     DeliveryStatus   @default(PENDING) @map("delivery_status")
  deliveryMethodId   String?          @map("delivery_method_id")
  deliveryMethodName String?          @map("delivery_method_name") @db.VarChar(200)
  deliveryDetails    String?          @map("delivery_details") @db.Text
  deliveryCost       Decimal          @default(0) @map("delivery_cost") @db.Decimal(10, 2)
  leadTime           String           @default("7–10 dni roboczych") @map("lead_time") @db.VarChar(200)
  discount           Decimal          @default(0) @db.Decimal(10, 2)
  discountNote       String?          @map("discount_note") @db.VarChar(300)
  taxRateId          String?          @map("tax_rate_id")
  taxAmount          Decimal          @default(0) @map("tax_amount") @db.Decimal(10, 2)
  paymentText        String           @map("payment_text") @db.Text
  handmadeText       String           @map("handmade_text") @db.Text
  shareHash          String           @unique @map("share_hash") @db.VarChar(64)
  shareEnabled       Boolean          @default(true) @map("share_enabled")
  notes              String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  createdById        String           @map("created_by_id")

  brand          Brand           @relation(fields: [brandId], references: [id])
  client         Client          @relation(fields: [clientId], references: [id])
  deliveryMethod DeliveryMethod? @relation(fields: [deliveryMethodId], references: [id], onDelete: SetNull)
  taxRate        TaxRate?        @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  createdBy      User            @relation(fields: [createdById], references: [id])
  items          OrderItem[]

  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String   @map("order_id")
  name         String   @db.VarChar(300)
  details      String?  @db.Text
  quantity     Int      @default(1)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  materialCost Decimal  @default(0) @map("material_cost") @db.Decimal(10, 2)
  sortOrder    Int      @default(0) @map("sort_order")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(50)
  entityId   String      @map("entity_id")
  changes    Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum AcceptanceStatus {
  PENDING
  ACCEPTED
}

enum PaymentStatus {
  PENDING
  DEPOSIT_PAID
  PAID
}

enum DeliveryStatus {
  PENDING
  IN_DELIVERY
  DELIVERED
  COMPLETED
}

enum AuditAction {
  CREATED
  UPDATED
  DELETED
}
